{# Animation controls UI #}
<div id="animation-controls" class="container-box stack-box" style="max-width: 300px;">
  <h4 style="margin: 0 0 10px 0;">Animation Recorder</h4>
  
  <button id="add-keyframe-btn" class="btn btn-primary" style="width: 100%; margin-bottom: 10px;">
    Add Keyframe
  </button>
  
  <div id="keyframes-list" style="max-height: 200px; overflow-y: auto; margin-bottom: 10px; background: #f5f5f5; padding: 5px; border-radius: 4px;">
    <p style="text-align: center; color: #999; margin: 20px 0;">No keyframes yet</p>
  </div>
  
  <button id="render-animation-btn" class="btn btn-success" style="width: 100%; margin-bottom: 5px;">
    Render Animation
  </button>
  
  <div id="render-progress" style="display: none; margin-top: 10px;">
    <div style="background: #ddd; height: 20px; border-radius: 4px; overflow: hidden;">
      <div id="progress-bar" style="background: #4CAF50; height: 100%; width: 0%; transition: width 0.3s;"></div>
    </div>
    <p id="progress-text" style="margin: 5px 0 0 0; font-size: 12px; text-align: center;"></p>
  </div>
</div>