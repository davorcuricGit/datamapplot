<!doctype html>
<html>
  <head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <title>{{ title }}</title>
    
    {#- External dependencies (fonts, Bootstrap, Font Awesome, JS libraries) -#}
    {% include 'head_dependencies.html.jinja2' %}
    
    {#- CSS styles (component CSS, page styles, custom CSS) -#}
    {% include 'styles.html.jinja2' %}
  </head>
  
  <body>
    {#- Loading indicator -#}
    {% include 'loading_indicator.html.jinja2' %}
    
    {#- Main content layout (deck container, stacks, logo) -#}
    {% include 'content_layout.html.jinja2' %}
    
    {#- Progress bars for data loading -#}
    {% include 'progress_bars.html.jinja2' %}
  </body>
  
  {#- JavaScript component libraries -#}
  {%- for _, js_src in js_dependency_srcs.items() %}
  <script>
    {{ js_src | safe }}
  </script>
  {%- endfor %}
  
  {#- Main application script -#}
  <script type="module">
    // =========================================================================
    // Utility Functions
    // =========================================================================
    
    {% include 'utilities.js.jinja2' %}
    
    {% include 'topic_tree_utils.js.jinja2' %}

    // =========================================================================
    // Browser Compatibility Check
    // =========================================================================
    
    if (!("CompressionStream" in window)) {
      throw new Error(
        "Your browser doesn't support the Compression Streams API " +
        "https://developer.mozilla.org/docs/Web/API/Compression_Streams_API#browser_compatibility"
      );
    }

    // =========================================================================
    // Data Setup
    // =========================================================================
    
    {% include 'data_setup.js.jinja2' %}

    // =========================================================================
    // DataMap Initialization
    // =========================================================================
    
    {% include 'datamap_init.js.jinja2' %}

    // =========================================================================
    // Data Loading Functions
    // =========================================================================
    
    {% include 'data_loaders.js.jinja2' %}

    // =========================================================================
    // Initialization
    // =========================================================================
    
    {%- if background_image %}
    datamap.addBackgroundImage("{{ background_image }}", {{ background_image_bounds }});
    {%- endif %}

    loadPointDataLayer();
    loadLabelDataLayer();
    loadMetaData();
    
    {%- if enable_histogram %}
    loadHistogramData();
    {%- endif %}
    
    // Enable edge panning
    // DISABLED: Edge panning conflicts with controller in controlled mode
    // Can re-enable once we resolve the viewState management conflicts
    // datamap.enableEdgePanning(50, 0.02); // 50px threshold, 0.02 max speed

    {%- if enable_animation_recorder %}
    //=========================================================================
    // Animation Recorder Setup
    //=========================================================================

    window.animationRecorder = new AnimationRecorder(datamap);

    // Update current view display
    function updateCurrentViewDisplay() {
      const viewport = datamap.deckgl.getViewports()[0];
      if (viewport) {
        document.getElementById('current-zoom').textContent = `Zoom: ${viewport.zoom.toFixed(2)}`;
        document.getElementById('current-lon').textContent = `Lon: ${viewport.longitude.toFixed(4)}`;
        document.getElementById('current-lat').textContent = `Lat: ${viewport.latitude.toFixed(4)}`;
      }
    }

    // Update display every 100ms
    setInterval(updateCurrentViewDisplay, 100);


    document.getElementById('add-keyframe-btn').addEventListener('click', () => {
      const kf = animationRecorder.addKeyframe();
      updateKeyframesList();
    });

    document.getElementById('render-animation-btn').addEventListener('click', () => {
      document.getElementById('render-progress').style.display = 'block';
      document.getElementById('progress-bar').style.width = '0%';
      
      animationRecorder.renderAnimation(30, (current, total) => {
        const percent = (current / total) * 100;
        document.getElementById('progress-bar').style.width = percent + '%';
        document.getElementById('progress-text').textContent = `Rendering: ${current}/${total} frames`;
      }).then(() => {
        document.getElementById('progress-text').textContent = 'Complete!';
        setTimeout(() => {
          document.getElementById('render-progress').style.display = 'none';
        }, 2000);
      });
    });

    function updateKeyframesList() {
      const list = document.getElementById('keyframes-list');
      const keyframes = window.animationRecorder.getKeyframesList();
      
      if (keyframes.length === 0) {
        list.innerHTML = '<p style="text-align: center; color: #999; margin: 20px 0;">No keyframes yet</p>';
        return;
      }
      
      list.innerHTML = keyframes.map(kf => `
        <div style="padding: 8px; border: 1px solid #ddd; margin-bottom: 5px; border-radius: 3px; background: white;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div style="flex: 1;">
              <div style="margin-bottom: 5px;">
                <strong>Frame:</strong> 
                <input 
                  type="number" 
                  value="${kf.frame}" 
                  onchange="window.animationRecorder.updateKeyframeTime(${kf.id}, parseInt(this.value)); updateKeyframesList();"
                  style="width: 70px; padding: 2px 4px; border: 1px solid #ccc; border-radius: 3px;"
                  min="0"
                />
              </div>
              <div style="margin-bottom: 5px;">
                <strong>Easing:</strong> 
                <select 
                  onchange="window.animationRecorder.updateKeyframeEasing(${kf.id}, this.value); updateKeyframesList();"
                  style="width: 120px; padding: 2px 4px; border: 1px solid #ccc; border-radius: 3px;"
                >
                  <option value="linear" ${kf.easing === 'linear' ? 'selected' : ''}>Linear</option>
                  <option value="ease-in" ${kf.easing === 'ease-in' ? 'selected' : ''}>Ease In</option>
                  <option value="ease-out" ${kf.easing === 'ease-out' ? 'selected' : ''}>Ease Out</option>
                  <option value="ease-in-out" ${kf.easing === 'ease-in-out' ? 'selected' : ''}>Ease In-Out</option>
                </select>
              </div>
              <div style="font-size: 11px; color: #666;">
                <div style="margin-bottom: 3px;">
                  <strong>Zoom:</strong> 
                  <input 
                    type="number" 
                    value="${kf.viewState.zoom.toFixed(2)}" 
                    onchange="window.animationRecorder.updateKeyframeViewState(${kf.id}, 'zoom', parseFloat(this.value)); updateKeyframesList();"
                    style="width: 60px; padding: 2px 4px; border: 1px solid #ccc; border-radius: 3px;"
                    step="0.1"
                  />
                </div>
                <div style="margin-bottom: 3px;">
                  <strong>Lon:</strong> 
                  <input 
                    type="number" 
                    value="${kf.viewState.longitude.toFixed(4)}" 
                    onchange="window.animationRecorder.updateKeyframeViewState(${kf.id}, 'longitude', parseFloat(this.value)); updateKeyframesList();"
                    style="width: 90px; padding: 2px 4px; border: 1px solid #ccc; border-radius: 3px;"
                    step="0.01"
                  />
                </div>
                <div>
                  <strong>Lat:</strong> 
                  <input 
                    type="number" 
                    value="${kf.viewState.latitude.toFixed(4)}" 
                    onchange="window.animationRecorder.updateKeyframeViewState(${kf.id}, 'latitude', parseFloat(this.value)); updateKeyframesList();"
                    style="width: 90px; padding: 2px 4px; border: 1px solid #ccc; border-radius: 3px;"
                    step="0.01"
                  />
                </div>
              </div>
            </div>
            <button 
              onclick="window.animationRecorder.removeKeyframe(${kf.id}); updateKeyframesList();" 
              style="cursor: pointer; background: #ff4444; color: white; border: none; padding: 4px 8px; border-radius: 3px; font-size: 12px; margin-left: 8px;"
            >Delete</button>
          </div>
        </div>
      `).join('');
    }
    {%- endif %}


    {%- if enable_api_tooltip %}
    const tooltip = new DynamicTooltipManager(
      datamap,
      {
        {%- if tooltip_identifier_js %}getIdentifier: {{ tooltip_identifier_js }},{% endif %}
        fetchData: {{ tooltip_fetch_js }},
        formatContent: {{ tooltip_format_js }},
        formatLoading: {{ tooltip_loading_js }},
        formatError: {{ tooltip_error_js }},
      }
    );
    {%- endif %}
    
    {%- if custom_js %}
    {{ custom_js }}
    {%- endif %}
  </script>
</html>
